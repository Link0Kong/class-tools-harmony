  /** 输入合法区间（dur 单独规则：>0 秒即可）。 */
  static rangeOf(key: string): number[] {
    if (key === 'h') {
      return [100, 250];
    }
    if (key === 'w') {
      return [25, 200];
    }
    if (key === 'vc') {
      return [500, 8000];
    }
    if (key === 'r50') {
      return [3, 15];
    }
    if (key === 'sit') {
      return [-20, 40];
    }
    if (key === 'jump') {
      return [50, 350];
    }
    if (key === 'pull') {
      return [0, 100];
    }
    return [];
  }
