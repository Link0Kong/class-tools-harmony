import { FitGrade, FitSex } from './FitModels';

/** 单项评分表：`hi=true` 越大越好（v>=阈值命中），否则越小越好（v<=阈值命中）。 */
export class FitScoreTable {
  hi: boolean;
  m12: number[];
  m34: number[];
  f12: number[];
  f34: number[];

  constructor(hi: boolean, m12: number[] = [], m34: number[] = [], f12: number[] = [], f34: number[] = []) {
    this.hi = hi;
    this.m12 = m12;
    this.m34 = m34;
    this.f12 = f12;
    this.f34 = f34;
  }

  column(sex: FitSex, grade: FitGrade): number[] {
    if (sex === FitSex.MALE) {
      return grade === FitGrade.G12 ? this.m12 : this.m34;
    }
    return grade === FitGrade.G12 ? this.f12 : this.f34;
  }
}

/** 加分表：`[超出量, 加分]`（从大到小）。 */
export class FitPlusTable {
  rows: number[][];

  constructor(rows: number[][]) {
    this.rows = rows;
  }

  plusFor(gap: number): number {
    if (gap <= 0) {
      return 0;
    }
    for (let i = 0; i < this.rows.length; i++) {
      if (gap >= this.rows[i][0]) {
        return this.rows[i][1];
      }
    }
    return 0;
  }
}

