{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1",
      "wearable"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            // 统一 HTTPS 内容链接（docs/app-links/CONTRACT.md）：独立 skill，不混入桌面启动 skill。
            // 域名校验依赖 https://tool.furina.fun/.well-known/applinking.json（appIdentifier 取自
            // HarmonyAppProvision 的 app-identifier，并需在 AppGallery Connect 开通 App Linking + 关联域名）。
            // 只声明客户端真正能处理的路径；/l/course/ 与 /l/file/ 仍由浏览器网页承接。
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "https",
                "host": "tool.furina.fun",
                "pathStartWith": "/l/draw/"
              },
              {
                "scheme": "https",
                "host": "tool.furina.fun",
                "pathStartWith": "/l/notice/"
              },
              {
                "scheme": "https",
                "host": "tool.furina.fun",
                "path": "/l/task-share"
              }
            ],
            "domainVerify": true
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "NotifyWorkAbility",
        "type": "workScheduler",
        "srcEntry": "./ets/work/NotifyWorkAbility.ets",
        "exported": false
      },
      {
        "name": "DeskFormAbility",
        "type": "form",
        "srcEntry": "./ets/forms/DeskFormAbility.ets",
        "label": "$string:EntryAbility_label",
        "description": "$string:desktop_forms_desc",
        "metadata": [
          { "name": "ohos.extension.form", "resource": "$profile:form_config" }
        ]
      }
    ],
    "metadata": [
      {
        "name": "client_id",
        "value": "6917621853264955129"
      },
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.PUBLISH_AGENT_REMINDER"
      },
      {
        "name": "ohos.permission.VIBRATE"
      }
    ]
  }
}
